# Google OAuth Client ID for authenticated access
VITE_GOOGLE_CLIENT_ID=your_client_id_here

# Google API Key for anonymous access to public sheets
# IMPORTANT: Restrict this key in Google Cloud Console to prevent unauthorized usage:
#   1. API restrictions -> Restrict key -> Google Sheets API
#   2. Application restrictions -> HTTP referrers (websites)
#      Add your domains: https://xsibas.pages.dev/*, https://*.xsibas.pages.dev/*
#      For local dev: http://localhost:5173/*, https://localhost:5173/*
VITE_GOOGLE_API_KEY=your_api_key_here

# OAuth Redirect Proxy URL
# This should point to your deployed Cloudflare Pages Function
# See OAUTH_SETUP.md for setup instructions
VITE_OAUTH_REDIRECT_URI=https://oauth-proxy.pages.dev/oauth/callback
