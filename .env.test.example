# Integration Test Environment Variables
#
# Copy this file to .env.test and fill in your values
# DO NOT commit .env.test to version control
#
# See TESTING.md for detailed setup instructions

# Service Account Email
# Get this from your Google Cloud Console service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private Key
# Option 1: Direct private key (with \n for newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Option 2: Base64 encoded private key (recommended for GitHub secrets)
# To encode: cat key.json | jq -r .private_key | base64 -w 0
# GOOGLE_PRIVATE_KEY=LS0tLS1CRUdJTi...

# Test Spreadsheet ID (required)
# A spreadsheet with proper schema (Exercises and WorkoutLog sheets)
TEST_SPREADSHEET_ID=1VB5ncABedr88ucuxfE6UdLv9OFKo0foTSJD0Qel6OtE

# Invalid Spreadsheet ID (optional)
# A spreadsheet without proper schema for negative testing
TEST_SPREADSHEET_ID_INVALID=

# Public Spreadsheet ID (optional)
# A publicly accessible spreadsheet for public access testing
TEST_SPREADSHEET_ID_PUBLIC=
